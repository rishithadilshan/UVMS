# Required. Use a managed PostgreSQL connection string in cloud deployments.
DATABASE_URL=postgresql://uvms_user:replace_with_password@localhost:5432/uvms
DATABASE_SSL=false
DB_POOL_MAX=10
PORT=5001
NODE_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=30m
CLIENT_URL=http://localhost:5173
# Required in production; comma-separated allowed student email domains.
ALLOWED_REGISTRATION_DOMAINS=
TRUST_PROXY=0

# Development-only demo data. Never enable in production.
ENABLE_DEMO_SEED=false
DEMO_ADMIN_NAME=Development Administrator
DEMO_ADMIN_EMAIL=admin@example.test
DEMO_ADMIN_PASSWORD=replace_with_a_unique_12_character_password

# --- UVMS enhancement settings ---
# Scheduler (reminders, pending-request expiry, waitlist). Runs inside the API process every 60 s.
DISABLE_SCHEDULER=false
SCHEDULER_INTERVAL_SECONDS=60
# Optional SMTP for approval/rejection emails (needs `npm i nodemailer`). Without it, emails are only recorded in email_log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=UVMS <no-reply@your-university.example>
# Students see the booker's name on "already booked" cards; set true to also show the e-mail address.
EXPOSE_BOOKER_EMAIL_TO_STUDENTS=false

# ---- performance / monitoring (all optional; defaults shown) ----
# DB_POOL_MAX=10                 # max PostgreSQL connections held by this API instance
# DB_STATEMENT_TIMEOUT_MS=30000  # abort any single SQL statement running longer than this (0 = off)
# DB_IDLE_TX_TIMEOUT_MS=60000    # close sessions left idle inside a transaction (protects against connection leaks)
# SLOW_REQUEST_MS=500            # log API requests slower than this (route pattern, status, total/db/app ms, query count)
# SLOW_QUERY_MS=250              # log SQL statements slower than this (text only, never parameter values)
# PERF_LOG_ALL=false             # true = log every request (development only)
# PERF_SERVER_TIMING=false       # true = add Server-Timing and X-DB-Queries response headers (visible in browser DevTools)
# GENERAL_RATE_LIMIT=100         # requests per IP per window on /api (default unchanged)
# GENERAL_RATE_WINDOW_MS=900000
