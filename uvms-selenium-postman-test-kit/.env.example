# Frontend URLs
BASE_URL=http://localhost:5173
LOGIN_URL=http://localhost:5173/login
BOOKING_URL=http://localhost:5173/bookings

# Disposable QA account only
QA_USERNAME=qa@example.com
QA_PASSWORD=ChangeMe123!

# Selenium
BROWSER=chrome
HEADLESS=false
IMPLICIT_WAIT_SECONDS=3
EXPLICIT_WAIT_SECONDS=15

# CSS selectors - use standard login controls; customize if the frontend differs.
SEL_LOGIN_USERNAME_CSS=input[type='email'], input[name='email'], input[name='username'], input[autocomplete='username']
SEL_LOGIN_PASSWORD_CSS=input[type='password'], input[name='password'], input[autocomplete='current-password']
SEL_LOGIN_SUBMIT_CSS=button[type='submit'], input[type='submit']
SEL_LOGIN_SUCCESS_CSS=[data-testid='app-shell']

SEL_BOOKING_VENUE_CSS=[data-testid='booking-venue']
SEL_BOOKING_DATE_CSS=[data-testid='booking-date']
SEL_BOOKING_START_CSS=[data-testid='booking-start-time']
SEL_BOOKING_END_CSS=[data-testid='booking-end-time']
SEL_BOOKING_SUBMIT_CSS=[data-testid='booking-submit']
SEL_BOOKING_ERROR_CSS=[data-testid='booking-error']
SEL_BOOKING_SUCCESS_CSS=[data-testid='booking-success']

# UI test fixture values - use a dedicated QA venue/date/time.
SEL_TEST_VENUE_VALUE=
SEL_TEST_DATE=2026-12-01
SEL_TEST_START=09:00
SEL_TEST_END=10:00
SEL_CONFLICT_START=09:30
SEL_CONFLICT_END=10:30
